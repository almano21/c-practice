#include <stdio.h>
//function definition
int getProduct(int number1, int number2) {
	int result = number1 * number2;
	return result;

}
//get integer inputs
int main(){
	int n1, n2;
	scanf_s("%d %d", &n1, &n2);

	//call function and store the returned value
	int result = getProduct(n1, n2);
	printf("%d", result);


	return 0;
	}
