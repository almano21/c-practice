#include <stdio.h > 

int main()
{
	// Get input value for operator
	char op;
	scanf_s("%c", &op);

	// Get input value of first and second numbers
	double first, second;
	scanf_s("%lf %lf", &first, &second);

	switch (op) {
	case '+' :
		printf("%.1lf", first + second);
		break;

	case '-' :
		printf("%.1lf", first - second);
		break;
	case '*':
		printf("%.1lf", first * second);
		break;
	case '/':
		printf("%.1lf", first / second);
		break;
	default:
		printf("invalid Operator");

	}
	return 0;
}
