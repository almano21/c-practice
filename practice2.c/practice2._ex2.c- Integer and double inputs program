#include <stdio.h>

int main()
{
    int number1;
    double number2;

    // Take number inputs
    printf("Enter an integer: ");
    scanf_s("%d", &number1);

    printf("Enter a double: ");
    scanf_s("%lf", &number2);

    // Print the outputs on separate lines
    printf("Your integer number is: %d\n", number1);
    printf("Your double number is: %.2f\n", number2);

    return 0;
}
