#include <stdio.h > 

int main() {

//take integer input
	int n;
	printf("Enter your number: ");
	scanf_s("%d", &n);

	int total = 1;

	// Loop from 1 up to n
	for (int i = 1; n >= i; i = i + 1 ) {
		total = total * i; // Multiply total by current number i
		
		
	}
	// Print the final factorial result
	printf("%d", total);

	return 0;
}
