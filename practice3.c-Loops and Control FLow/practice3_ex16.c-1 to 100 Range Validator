#include <stdio.h > 

int main()
{
	int number;
	while (1)
	{
		//Get input from the use
		scanf_s("%d", &number);

		// If the number is outside 1-100, exit the loop
		if (number < 1 || number > 100) 
		{
			break;
		}
		else
		{
			//Prints the numbers
			printf("%d\n", number);
		}


	}


	return 0;
}
