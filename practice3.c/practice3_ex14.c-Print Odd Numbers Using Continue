#include <stdio.h > 

int main()
{
	int n;
	//Get integer input
	printf("Enter your number: ");
	scanf_s("%d", &n);

	//iterates and prints odd numbers from i to n
	for (int i = 0; i <= n; ++i) {
		if (i % 2 == 0) {
            continue;
		}
		else {
			printf("%d\n", i);
		}
			


	}

	return 0;
}
