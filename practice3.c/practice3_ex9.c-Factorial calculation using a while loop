#include <stdio.h > 

int main() {
	int n; 

	// get a number input 
	printf("Enter your number: ");
	scanf_s("%d", &n);

	//initial value of total is 1
	int total = 1;
	int i = 1;
	 
	//run a while loop from i to n
	while (n >= i) {
		total = total * i;
		i = i + 1;
		
		
	}
printf("%d", total);
	

	return 0;
}
