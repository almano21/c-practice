#include <stdio.h>

int main() {

	// array of numbers
	int arr[5] = { 1, 2, 3, 4, 5 };

	// new array for multipled numbers
	int newArr[5];

	// loop for multipling each element and assigning to a new array
	for (int i = 0; i < 5; ++i) {
		newArr[i] = arr[i] * 10;
		printf("%d\n", newArr[i]);
	}


  return 0;
}
