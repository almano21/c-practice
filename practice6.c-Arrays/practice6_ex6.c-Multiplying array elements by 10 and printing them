#include <stdio.h>

int main() {
	// an array of numbers
	int numbers[4] = { 43, 78, 23, 45 };

	//new array for nummbers
	int newNumbers[4];

  // loop through each element of numbers and multiply them by 10
	for (int i = 0; i < 4; ++i) {
	  newNumbers[i] = numbers[i] * 10;

      printf("%d\n", newNumbers[i]);
	}
	return 0;
}
