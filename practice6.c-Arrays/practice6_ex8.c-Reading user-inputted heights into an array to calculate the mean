#include <stdio.h>

int main() {
	double heights[11];
    
	double sum = 0.0;

	// finding sum of all heights
	for (int i = 0; i < 11; ++i) {
		
		//input heights
		scanf_s("%lf", &heights[i]);
		sum = sum + heights[i];

	}

	// finding the mean height
	double mean = sum / 11;
	printf("%.2lf\n", mean);

	return 0;
}
