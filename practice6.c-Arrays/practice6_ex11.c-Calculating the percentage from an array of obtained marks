#include <stdio.h>

int main() {
	double marks[8];
	
    int totalMarks = 800;
	double obtainedMarks = 0.0;
	
	// get input value for obtained marks
	for (int i = 0; i < 8; ++i) {
      scanf_s("%lf", &marks[i]);
     obtainedMarks = obtainedMarks + marks[i];
	}
 
	// find the percentage of marks 
	  double percentage = obtainedMarks/ totalMarks * 100;
	 printf("%.2lf", percentage);

	return 0;
}
