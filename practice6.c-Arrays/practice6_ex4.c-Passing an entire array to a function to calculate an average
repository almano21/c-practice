#include <stdio.h>

// function to find the average marks
double findAverage(double marks[])
{
	double sum = 0.0;

	// sum of all elements 
	for (int i = 0; i < 5; ++i) {
		sum = sum + marks[i];  
	}
	// finding the average by dividing sum by the total number of array elements
	double average = sum / 5;
     return average;
	
}

int main() {
	double marks[5] = { 54.8, 59.8, 48.7, 42.6, 60.1 };
	// call the function 
	double result = findAverage(marks);

	printf("%.2lf", result);

	return 0;

}
